{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/products/koelai-ai", "destination": "/services/ai-agent-development", "permanent": true },
    { "source": "/products/koelai-ai.html", "destination": "/services/ai-agent-development", "permanent": true },
    { "source": "/services/ai-calling-agent-india", "destination": "/services/ai-agent-development", "permanent": true },
    { "source": "/blog/ai-calling-agent-india", "destination": "/services/ai-agent-development", "permanent": true },
    { "source": "/blog/ai-calling-agent-for-startups-india", "destination": "/services/ai-agent-development", "permanent": true },
    { "source": "/blog/ai-agent-vs-human-receptionist-india", "destination": "/services/ai-agent-development", "permanent": true },
    { "source": "/clinic-automation/ai-receptionist-clinic-india", "destination": "/clinic-automation", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ]
}
